{
  "name": "vork-bot",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vork/desktop dev",
    "test": "pnpm -r --workspace-concurrency=1 --filter '!@vork/e2e' test",
    "e2e": "pnpm --filter @vork/e2e test",
    "healthcheck": "node scripts/dev-healthcheck.mjs",
    "smoke": "node scripts/dev-smoke.mjs",
    "ui:check": "node scripts/ui-parity/check.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
