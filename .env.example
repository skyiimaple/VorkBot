# Local development only. Change the database password before any nonlocal deployment.
VORK_DB_PASSWORD=vork_dev_only
DATABASE_URL=postgres://vork:vork_dev_only@127.0.0.1:5432/vork
REDIS_URL=redis://127.0.0.1:6379
VORK_API_BASE_URL=http://127.0.0.1:3000

# Cloud computer (Compose only — no host port; api/worker use http://computer:8080).
VORK_COMPUTER_TOKEN=vork_computer_dev_only
# Optional local overrides; Compose defaults to 3 slots / 2 browser slots.
# VORK_MAX_SLOTS=3
# VORK_MAX_BROWSER_SLOTS=2
# Force browser acquire rejection for tests: VORK_MEMORY_PRESSURE=1

# Default Agents SDK model (DeepSeek). No OpenAI key is required.
# Leave LLM_API_KEY empty to use the local FakeModel fallback.
# Worker reads these via Compose env substitution from this file / host environment.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Optional: force FakeModel even when LLM_API_KEY is set
# VORK_MODEL_PROVIDER=fake
# Optional request timeout (ms)
# LLM_TIMEOUT_MS=60000

# Default runtime: agents-sdk. Models configured in the desktop app take priority.
# VORK_AGENT_RUNTIME=agents-sdk
# Optional hosted OpenAI Agents API; only used with VORK_AGENT_RUNTIME=openai-agents.
# The key needs api.agents.read, api.agents.write and api.responses.write permissions.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-6-astra
# Optional for compatible OpenAI gateways; normally leave unset.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Explicitly restore the previous Vork model/agent loop when needed.
# VORK_AGENT_RUNTIME=legacy
